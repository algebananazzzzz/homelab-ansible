# Managed by Ansible. Hermes merges these keys over ~/.hermes/config.yaml and refuses to change them.
dashboard:
  public_url: https://{{ hermes_hostname }}
  # Traefik terminates TLS, so its forwarded scheme decides whether login cookies are Secure.
  trusted_proxies:
    - {{ hostvars[groups['traefik'] | first].ansible_host }}
  oauth:
    provider: self-hosted
    self_hosted:
      issuer: https://auth.{{ base_domain }}
      client_id: hermes

web:
  search_backend: forage
  extract_backend: forage

mcp_servers:
  # Kaneo's HTTP endpoint accepts only OAuth, so it is signed in once with `hermes mcp login kaneo`.
  kaneo:
    url: https://kaneo.{{ base_domain }}/api/mcp
    auth: oauth
  outline:
    url: https://outline.{{ base_domain }}/mcp
    headers:
      Authorization: "Bearer ${OUTLINE_API_KEY}"
  # Windmill puts the workspace and the token in the URL it generates.
  windmill:
    url: "${WINDMILL_MCP_URL}"
