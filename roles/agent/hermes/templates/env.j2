# Managed by Ansible. Hermes gives these precedence over ~/.hermes/.env and the shell.
# Python clients default to certifi's bundle, which lacks the internal CA that signs every *.{{ base_domain }} certificate on the LAN.
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
FORAGE_URL=http://127.0.0.1:3672
# `hermes update` rebuilds the venv with uv, which would otherwise pick Debian's Python and its SQLite 3.40.
UV_PYTHON_PREFERENCE=only-managed
