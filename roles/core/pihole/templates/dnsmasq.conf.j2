local=/home.arpa/

# Traefik routes by hostname.
host-record=home.arpa,10.10.20.10
address=/svc.home.arpa/10.10.20.10
address=/ops.home.arpa/10.10.20.10
address=/media.home.arpa/10.10.20.10
address=/algebananazzzzz.com/10.10.20.10

host-record=hv-01.home.arpa,10.10.10.1
{% for host in groups['vm'] %}
host-record={{ host }}.home.arpa,{{ hostvars[host].vm_definition.address }}
{% endfor %}

# Lab VMs have dynamic addresses, so their bridge's DHCP server answers for them.
server=/lab.home.arpa/10.10.30.1

server=/consul/10.10.20.10#8600
