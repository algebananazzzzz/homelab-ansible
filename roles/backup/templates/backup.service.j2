[Unit]
Description=Back up {{ backup_job }} to restic

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/env
{% if backup_job == 'lab-vms' %}
Environment="LAB_VMS={{ groups['lab'] | join(' ') }}" "STORAGE_ROOT={{ vm_storage }}"
{% endif %}
ExecStart=/usr/local/bin/backup-{{ backup_job }}
ExecStopPost=/usr/local/bin/backup-metrics {{ backup_job }} {{ backup_schedules[backup_job].max_age }} %n
